# ==========================================================
# NeerVibe — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# --- Application ---
APP_NAME="NeerVibe — Logistics Control Tower"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logistics_control_tower
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://logistics:change-me@localhost:5432/logistics_control_tower
DATABASE_URL_SYNC=postgresql+psycopg2://logistics:change-me@localhost:5432/logistics_control_tower

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Simulation Engine ---
SIMULATION_TICK_SECONDS=3
SIMULATION_VEHICLE_COUNT=40
SIMULATION_PACKAGE_SPAWN_RATE=5

# --- ML / TensorFlow ---
ML_MODEL_DIR=./ml/models/artifacts
ML_ETA_MODEL_NAME=eta_predictor_v1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate limiting (architecture placeholder) ---
RATE_LIMIT_PER_MINUTE=120
